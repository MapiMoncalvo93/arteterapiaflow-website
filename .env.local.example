# ─── Calendly ────────────────────────────────────────────────────────────────
# URL de tu perfil o evento de Calendly.
# Ejemplo: https://calendly.com/tu-usuario
# Ejemplo con evento específico: https://calendly.com/tu-usuario/sesion-individual
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/tu-usuario

# ─── Instagram ───────────────────────────────────────────────────────────────
# Token de acceso de largo plazo (Long-Lived Access Token) de Instagram Basic Display API.
# Ver instrucciones en INSTAGRAM_SETUP.md
NEXT_PUBLIC_INSTAGRAM_TOKEN=tu_token_aqui
